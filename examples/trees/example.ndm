+[subject: architectural_element = roof]
 -[feature: roof_ventilation = (open; closed)]
 -[feature: skylight_area = (A1; A2; A3; A4)]
+[subject: architectural_element = skylight]
 -[feature: skylight_transparency = (clear; transparent)]
 -[feature: skylight_insulation = (not_insulated; insulated)]
+[subject: architectural_element = roof_cladding]
 -[feature: roof_cladding_insulation = (no_change; add_insulation)]
+[subject: architectural_element = window_frame]
 -[feature: window_frame_ventilation = (open; closed)]
 -[feature: window_frame_insulation = (not_insulated; insulated)]
+[subject: architectural_element = brick_facade]
 -[feature: brick_facade_insulation = (no_change; add_insulation)]
+[subject: architectural_element = ground_floor]
 -[feature: ground_floor_remove_area = (F1; F2; F3; F4)]
+[subject: architectural_element = original_floor]
 -[feature: original_floor_refurbishment = (no change; level_or_regulate; add_insulation_and_floor)]
+[subject: architectural_element = stripped_terrain]
 -[feature: stripped_terrain_new = (greenhouse; add_insulation_and_floor)]
+[subject: architectural_element = layout]
 -[feature: layout_number_of_floors = (1; 2)]
 -[]
  +[feature: add_tinyhouses = no]
  +[feature: add_tinyhouses = yes]
   -[feature: tinyhouse_size = (T1; T2)]
   -[feature: tinyhouse_number = (N1; N2)]
   -[feature: tinyhouse_roof_accessible = (no; yes)]
   -[feature: tinyhouse_roof_insulation = (no; yes)]
